// DualTitle.rc — Icon, Manifest & Version Metadata
#include <winver.h>

#define IDI_APPICON 101
IDI_APPICON ICON "../assets/dualtitle.ico"

// Per-Monitor V2 DPI awareness (crisp on any scaled display)
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION 5,0,0,0
 PRODUCTVERSION 5,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DualTitle Project"
            VALUE "FileDescription", "DualTitle — Universal Dual Subtitle Overlay & Save Guard"
            VALUE "FileVersion", "5.0.0"
            VALUE "InternalName", "DualTitle"
            VALUE "LegalCopyright", "DualTitle Project — MIT-style, provided as is"
            VALUE "OriginalFilename", "DualTitle.exe"
            VALUE "ProductName", "DualTitle"
            VALUE "ProductVersion", "5.0.0 (Aurora)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
